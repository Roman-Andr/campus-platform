msgid "A cancellation reason is required."
msgstr "Нужна причина отмены."

msgid "A chat must have two different members."
msgstr "В чате должно быть два разных участника."

#, python-brace-format
msgid "A lesson has from {min} to {max} time options."
msgstr "В занятии должно быть от {min} до {max} вариантов времени."

msgid "A meeting time and place were proposed."
msgstr "Второй участник предложил время и место встречи."

msgid "A participant asks to leave the purchase."
msgstr "Участник просит выйти из закупки."

msgid ""
"A place in the queue is available for you. Confirm it before the timer "
"ends."
msgstr ""
"Для вас освободилось место в очереди. Подтвердите его до истечения "
"таймера."

msgid "Accepted interactions can only be cancelled with a reason."
msgstr "Принятые взаимодействия можно отменить только с указанием причины."

msgid "An event or return deadline is approaching."
msgstr "Приближается мероприятие или срок возврата."

#, python-brace-format
msgid "Another complaint reason already uses the code {code}."
msgstr "Другой причиной жалобы уже используется код {code}."

msgid "Ask the organiser before leaving the purchase."
msgstr "Попросите организатора перед выходом из закупки."

#, python-brace-format
msgid "At most {max} skills."
msgstr "Не больше {max} навыков."

msgid "Authentication required"
msgstr "Требуется вход в аккаунт"

msgid "Bad request"
msgstr "Некорректный запрос"

msgid "Book the listing instead of joining its queue."
msgstr "Забронируйте объявление вместо того, чтобы вставать в очередь."

msgid "Campus account security notification"
msgstr "Уведомление о безопасности аккаунта Кампус"

msgid "Cancel your application before joining the queue."
msgstr "Отмените заявку, чтобы встать в очередь."

msgid "Cannot remove the last corporate address"
msgstr "Нельзя удалить последний корпоративный адрес"

msgid "Channel is not available"
msgstr "Канал недоступен"

msgid "Chat not available"
msgstr "Чат недоступен"

msgid "Chat not found"
msgstr "Чат не найден"

msgid "Choose a listing category."
msgstr "Выберите категорию объявления."

msgid "Choose a published version of the community rules."
msgstr "Выберите опубликованную версию правил сообщества."

msgid "Client version missing"
msgstr "Не указана версия клиента"

msgid ""
"Confirm the current scenario stage by its own action; an online QR code "
"completes only the final meeting."
msgstr ""
"Подтвердите текущий этап сценария отдельным действием; онлайн-QR-код "
"завершает только финальную встречу."

#, python-brace-format
msgid ""
"Confirm your e-mail address with code: {code}. It expires in {minutes} "
"minutes."
msgstr ""
"Подтвердите адрес электронной почты кодом: {code}. Он действует {minutes}"
" минут."

msgid "Current documents must be accepted"
msgstr "Необходимо принять актуальные документы"

msgid "Describe the item you offer."
msgstr "Опишите вещь, которую предлагаете."

msgid "Device key conflict"
msgstr "Конфликт ключа устройства"

msgid "E-mail address already in use"
msgstr "Адрес электронной почты уже используется"

msgid "E-mail address not found"
msgstr "Адрес электронной почты не найден"

msgid "E-mail domain does not match address kind"
msgstr "Домен электронной почты не соответствует виду адреса"

msgid "Employees have no course."
msgstr "У сотрудников нет курса."

msgid "Fill in your profile first: campus city, faculty and course."
msgstr "Сначала заполните профиль: город-кампус, факультет и курс."

msgid "First and last names are required"
msgstr "Укажите имя и фамилию"

msgid "Forbidden"
msgstr "Доступ запрещён"

msgid "Has an invalid format."
msgstr "Неверный формат."

msgid "Idempotency key missing"
msgstr "Нет ключа идемпотентности"

msgid "Idempotency key reused"
msgstr "Ключ идемпотентности уже использован"

msgid "Interaction already completed"
msgstr "Взаимодействие уже завершено"

msgid "Internal error"
msgstr "Внутренняя ошибка"

msgid "Invalid cancellation reason."
msgstr "Некорректная причина отмены."

msgid "Invalid client version"
msgstr "Неверная версия клиента"

msgid "Invalid consent decision"
msgstr "Недопустимое решение по согласию"

msgid "Invalid cursor"
msgstr "Неверный курсор"

msgid "Invalid help deadline"
msgstr "Неверный срок актуальности запроса"

msgid "Invalid idempotency key"
msgstr "Неверный ключ идемпотентности"

msgid "Invalid lesson time options"
msgstr "Неверные варианты времени занятия"

msgid "Invalid meeting place"
msgstr "Неверное место встречи"

msgid "Invalid meeting time"
msgstr "Неверное время встречи"

msgid "Invalid offer"
msgstr "Неверное предложение"

msgid "Invalid purchase deadline"
msgstr "Неверный дедлайн сбора закупки"

msgid "Invalid purchase volume"
msgstr "Неверный объём закупки"

msgid "Invalid quiet hours"
msgstr "Неверные параметры тихих часов"

msgid "Invalid realtime channel"
msgstr "Неверный канал реального времени"

msgid "Invalid refresh token"
msgstr "Недействительный токен обновления"

msgid "Invalid request"
msgstr "Неверные данные запроса"

msgid "Invalid rules clause"
msgstr "Неверный пункт правил"

msgid "Invalid search query."
msgstr "Неверный поисковый запрос."

msgid "Invalid sign-in code"
msgstr "Неверный код входа"

msgid "Leave the purchase directly while it is collecting."
msgstr "Выйти из закупки можно напрямую на этапе сбора."

msgid "Leave the queue before joining it again."
msgstr "Выйдите из очереди, чтобы встать в неё снова."

msgid "Method not allowed"
msgstr "Метод не поддерживается"

msgid "Must be a UUID."
msgstr "Должно быть UUID."

msgid "Must be a date and time."
msgstr "Должно быть датой и временем."

msgid "Must be a date."
msgstr "Должно быть датой."

msgid "Must be a list."
msgstr "Должно быть списком."

msgid "Must be a number."
msgstr "Должно быть числом."

msgid "Must be a string."
msgstr "Должно быть строкой."

msgid "Must be an integer."
msgstr "Должно быть целым числом."

msgid "Must be an object."
msgstr "Должно быть объектом."

#, python-brace-format
msgid "Must be at least {ge}."
msgstr "Должно быть не меньше {ge}."

#, python-brace-format
msgid "Must be at least {min_length} characters long."
msgstr "Минимальная длина — {min_length}."

#, python-brace-format
msgid "Must be at most {le}."
msgstr "Должно быть не больше {le}."

#, python-brace-format
msgid "Must be at most {max_length} characters long."
msgstr "Максимальная длина — {max_length}."

#, python-brace-format
msgid "Must be at most {max}."
msgstr "Должно быть не больше {max}."

#, python-brace-format
msgid "Must be greater than {gt}."
msgstr "Должно быть больше {gt}."

#, python-brace-format
msgid "Must be less than {lt}."
msgstr "Должно быть меньше {lt}."

msgid "Must be one of the chosen city."
msgstr "Должно относиться к выбранному городу."

#, python-brace-format
msgid "Must be one of: {expected}."
msgstr "Допустимые значения: {expected}."

msgid "Must be true or false."
msgstr "Должно быть true или false."

#, python-brace-format
msgid "Must have at least {min_length} items."
msgstr "Минимальное число элементов — {min_length}."

#, python-brace-format
msgid "Must have at most {max_length} items."
msgstr "Максимальное число элементов — {max_length}."

msgid "Name changed recently"
msgstr "Имя недавно менялось"

msgid "No such campus city."
msgstr "Такого города-кампуса нет."

msgid "No such skill tag."
msgstr "Такого навыка нет в справочнике."

msgid "Not enough units left."
msgstr "Не хватает свободных единиц."

msgid "Not found"
msgstr "Не найдено"

msgid ""
"Only an accepted online lesson or a help interaction without an agreed "
"meeting can be completed this way."
msgstr ""
"Так можно завершить только принятое онлайн-занятие или помощь без "
"назначенной встречи."

msgid "Only the composition exchange is available at this stage."
msgstr "На этом этапе доступны только действия с составом закупки."

msgid "Only the two participants of the interaction can confirm it."
msgstr "Подтвердить взаимодействие могут только два его участника."

#, python-brace-format
msgid "Only {available} units are available."
msgstr "Доступно только {available} ед."

msgid "Personal messaging with this user is not available."
msgstr "Личные сообщения этому пользователю недоступны."

msgid "Photo unavailable"
msgstr "Фото недоступно"

msgid "Places are open to everyone; book now."
msgstr "Места открыты для всех; бронируйте сейчас."

msgid "Profile incomplete"
msgstr "Профиль не заполнен"

msgid "QR code already used"
msgstr "QR-код уже использован"

msgid "QR code cannot be used"
msgstr "QR-код нельзя использовать"

msgid "QR code cannot complete this stage"
msgstr "QR-код не может завершить этот этап"

msgid "QR code expired"
msgstr "Срок QR-кода истёк"

msgid "QR code is from the future"
msgstr "Время QR-кода в будущем"

msgid "QR code rejected"
msgstr "QR-код отклонён"

msgid "QR confirmation is unavailable"
msgstr "Подтверждение по QR недоступно"

msgid "Quiet hours must start and end at different times."
msgstr "Начало и конец тихих часов должны различаться."

msgid "Realtime history expired"
msgstr "История реального времени устарела"

msgid "Realtime is unavailable"
msgstr "Реальное время недоступно"

#, python-brace-format
msgid "Reload the complaint reason. Its current version is {version}."
msgstr "Обновите причину жалобы. Её текущая версия: {version}."

#, python-brace-format
msgid "Reload the interaction. The current meeting version is {version}."
msgstr "Обновите взаимодействие. Текущая версия встречи: {version}."

#, python-brace-format
msgid "Reload the listing. Its current version is {version}."
msgstr "Обновите объявление. Его текущая версия: {version}."

#, python-brace-format
msgid "Reload the settings. Their current version is {version}."
msgstr "Обновите настройки. Их текущая версия: {version}."

msgid "Request failed"
msgstr "Запрос не выполнен"

msgid "Requests that change data need an Idempotency-Key header."
msgstr "Изменяющему запросу нужен заголовок Idempotency-Key."

msgid "Send the current settings version to replace muted chats."
msgstr "Укажите текущую версию настроек, чтобы заменить список отключённых чатов."

msgid "Session not found"
msgstr "Сессия не найдена"

msgid "Sign-in attempts exceeded"
msgstr "Превышено число попыток входа"

msgid "Sign-in code expired or already used"
msgstr "Код входа истёк или уже использован"

msgid "Some fields of the request are invalid."
msgstr "Некоторые поля запроса заполнены неверно."

msgid "Someone joined the queue of your listing."
msgstr "В очередь вашего объявления встал новый участник."

msgid "Something went wrong on our side. Please try again later."
msgstr "Что-то пошло не так на нашей стороне. Попробуйте позже."

msgid "Students must give their course."
msgstr "Студенту нужно указать курс."

msgid "The Idempotency-Key header must be a UUID."
msgstr "Заголовок Idempotency-Key должен быть UUID."

msgid "The QR code payload is malformed or does not match the request."
msgstr "Содержимое QR-кода повреждено или не относится к запросу."

msgid "The QR code signature is invalid."
msgstr "Подпись QR-кода неверна."

msgid "The QR code time is ahead of the server clock by too much."
msgstr "Время QR-кода слишком опережает серверные часы."

msgid "The X-Client-Platform and X-Client-Version headers are required."
msgstr "Нужны заголовки X-Client-Platform и X-Client-Version."

#, python-brace-format
msgid "The author cancelled the listing: {reason}"
msgstr "Автор отменил объявление: {reason}"

msgid "The capacity cannot be less than the number registered."
msgstr "Лимит мест не может быть меньше числа записавшихся."

msgid "The channel name is not a Campus realtime channel."
msgstr "Имя канала не является каналом реального времени Кампуса."

msgid "The chat does not exist or you are not a member."
msgstr "Чат не существует или вы не его участник."

msgid "The client platform or version is not recognized."
msgstr "Платформа или версия клиента не распознаны."

msgid ""
"The collection deadline must be in the future and within the listing "
"lifetime."
msgstr "Дедлайн сбора должен быть в будущем и не позже срока жизни объявления."

msgid "The collection of the purchase ends soon."
msgstr "Сбор закупки скоро завершится."

msgid "The complaint reason code is already used"
msgstr "Код причины жалобы уже используется"

msgid "The complaint reason was edited"
msgstr "Причина жалобы была изменена"

msgid "The composition is fixed."
msgstr "Состав закупки зафиксирован."

msgid "The composition is not fixed yet."
msgstr "Состав закупки ещё не зафиксирован."

msgid "The conditions of the purchase have changed."
msgstr "Условия закупки изменились."

#, python-brace-format
msgid "The current volume is {taken} units."
msgstr "Текущий объём — {taken} ед."

msgid "The device key is unknown, revoked or belongs to another user."
msgstr "Ключ устройства неизвестен, отозван или принадлежит другому пользователю."

msgid "The event must start in the future and end after its start."
msgstr "Мероприятие должно начинаться в будущем и заканчиваться после начала."

msgid "The event time or location has changed."
msgstr "Время или место мероприятия изменено."

msgid ""
"The help request must expire in the future and within the listing "
"lifetime."
msgstr ""
"Запрос о помощи должен завершаться в будущем и не позже срока жизни "
"объявления."

msgid "The interaction is not accepted and cannot be completed."
msgstr "Взаимодействие не принято и не может быть завершено."

msgid "The interaction must be accepted and have a current meeting proposal."
msgstr "Взаимодействие должно быть принято и иметь текущее предложение встречи."

msgid "The interaction was completed by another method."
msgstr "Взаимодействие завершено другим способом."

msgid "The listing and the interaction do not belong together."
msgstr "Объявление и взаимодействие не относятся друг к другу."

msgid "The listing is closed; you are no longer in its queue."
msgstr "Объявление закрыто; вы больше не в его очереди."

msgid "The listing state has changed."
msgstr "Состояние объявления изменилось."

msgid "The listing still has a free place."
msgstr "В объявлении ещё есть свободное место."

msgid "The listing text is empty or too long."
msgstr "Текст объявления пуст или слишком длинный."

msgid "The listing type has no limited places to wait for."
msgstr ""
"У объявлений этого типа нет ограниченного числа мест, за которые ждут в "
"очереди."

msgid "The listing was edited."
msgstr "Объявление было изменено."

msgid "The maximum is below the taken volume."
msgstr "Максимальный объём меньше уже занятого."

msgid "The meeting cannot be changed."
msgstr "Встречу нельзя изменить."

msgid "The meeting has been rescheduled."
msgstr "Встреча перенесена."

msgid "The meeting is scheduled."
msgstr "Встреча назначена."

msgid "The meeting place must not be empty or too long."
msgstr "Место встречи не должно быть пустым или слишком длинным."

msgid "The meeting proposal has changed."
msgstr "Предложение встречи изменилось."

msgid "The meeting time must be in the future."
msgstr "Время встречи должно быть в будущем."

msgid "The message identifier is already used."
msgstr "Идентификатор сообщения уже использован."

msgid "The message text is empty or too long."
msgstr "Текст сообщения пуст или слишком длинный."

msgid "The minimum must not exceed the maximum, and both must be positive."
msgstr ""
"Минимум не должен превышать максимум, и оба значения должны быть "
"положительными."

#, python-brace-format
msgid "The name can be changed once in {days} days; see available_at."
msgstr "Имя можно менять раз в {days} дней; ближайшая дата — в available_at."

msgid "The notification settings were changed."
msgstr "Настройки уведомлений были изменены."

#, python-brace-format
msgid "The notification type {type} is not supported."
msgstr "Тип уведомления {type} не поддерживается."

msgid "The offer of a place has expired."
msgstr "Срок предложения места истёк."

msgid "The online QR code is older than the allowed lifetime."
msgstr "Онлайн-QR-код старше допустимого срока."

#, python-brace-format
msgid "The organiser cancelled the purchase: {reason}"
msgstr "Организатор отменил закупку: {reason}"

msgid "The organiser has decided on your request to leave."
msgstr "Организатор принял решение по вашему запросу на выход."

msgid "The page cursor is invalid or belongs to another list; start over."
msgstr "Курсор страницы неверен или относится к другому списку; начните сначала."

msgid "The photo is not processed yet, has expired or is used by a listing."
msgstr "Фото ещё обрабатывается, устарело или уже прикреплено к объявлению."

msgid "The place is offered to another participant."
msgstr "Место предложено другому участнику."

msgid "The purchase composition is fixed."
msgstr "Состав закупки зафиксирован."

msgid "The purchase is cancelled."
msgstr "Закупка отменена."

msgid "The purchase is no longer collecting."
msgstr "Закупка больше не на этапе сбора."

msgid "The realtime server is temporarily unavailable. Try again later."
msgstr "Сервер реального времени временно недоступен. Повторите попытку позже."

#, python-brace-format
msgid "The reason must be at most {max} characters."
msgstr "Причина должна быть не длиннее {max} символов."

msgid "The request body is not valid JSON."
msgstr "Тело запроса — некорректный JSON."

msgid ""
"The requested position is no longer in realtime history. Reload the "
"channel state through the API."
msgstr ""
"Запрошенная позиция уже отсутствует в истории реального времени. "
"Перезагрузите состояние канала через API."

msgid "The requested resource does not exist."
msgstr "Запрошенный ресурс не существует."

msgid "The resource does not support this method."
msgstr "Ресурс не поддерживает этот метод."

msgid "The same client message identifier carries different content."
msgstr "Один и тот же идентификатор сообщения клиента передан с другим содержимым."

msgid "The same participant cannot show and scan the same QR code."
msgstr "Один и тот же участник не может показывать и сканировать один QR-код."

#, python-brace-format
msgid "The search query must be at most {max_length} characters."
msgstr "Поисковый запрос должен быть не длиннее {max_length} символов."

msgid "There is an update to your listing."
msgstr "Появилось обновление вашего объявления."

msgid "This Idempotency-Key was already used for a different request."
msgstr "Этот Idempotency-Key уже использован для другого запроса."

msgid "This action is not allowed."
msgstr "Это действие запрещено."

msgid "This field is not allowed."
msgstr "Это поле недопустимо."

msgid "This field is required."
msgstr "Обязательное поле."

msgid "This interaction cannot be completed without a meeting."
msgstr "Это взаимодействие нельзя завершить без встречи."

msgid "This listing has no queue."
msgstr "У этого объявления нет очереди."

msgid "This one-time QR code has already been used."
msgstr "Этот одноразовый QR-код уже использован."

msgid "This public key is already registered to another device session."
msgstr "Этот открытый ключ уже зарегистрирован в другой сессии устройства."

msgid "This type of interaction is not completed with an online QR code."
msgstr "Этот тип взаимодействия не завершается онлайн-QR-кодом."

#, python-brace-format
msgid ""
"This version of the app is no longer supported. Please update to "
"{version} or newer."
msgstr ""
"Эта версия приложения больше не поддерживается. Обновите его до версии "
"{version} или новее."

msgid "Too many listing actions. Try again later."
msgstr "Слишком много действий с объявлениями. Попробуйте позже."

msgid "Too many messages. Try again later."
msgstr "Слишком много сообщений. Попробуйте позже."

msgid "Too many requests"
msgstr "Слишком много запросов"

msgid "Unknown notification type"
msgstr "Неизвестный тип уведомления"

msgid "Update required"
msgstr "Требуется обновление"

msgid "Use RFC 3339 with an explicit UTC offset."
msgstr "Используйте RFC 3339 с явно указанным смещением UTC."

msgid "Use a wall time without a UTC offset."
msgstr "Укажите время без смещения часового пояса."

msgid "Wait for the author's decision."
msgstr "Дождитесь решения автора."

msgid "Wait for the offer timer to end or join the queue."
msgstr "Дождитесь окончания таймера предложения или встаньте в очередь."

msgid "You already asked to leave the purchase."
msgstr "Вы уже попросили выйти из закупки."

msgid "You already joined the purchase."
msgstr "Вы уже участвуете в закупке."

msgid "You already offered an item."
msgstr "Вы уже предложили вещь."

msgid "You already participate in this listing."
msgstr "Вы уже участвуете в этом объявлении."

msgid "You are already in the queue."
msgstr "Вы уже стоите в очереди."

msgid "You are not a member of this channel."
msgstr "Вы не участник этого канала."

msgid "You are not a member of this chat."
msgstr "Вы не участник этого чата."

