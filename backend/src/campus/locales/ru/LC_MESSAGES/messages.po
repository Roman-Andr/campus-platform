msgstr "Вы уже участвуете в этом объявлении."

msgid "You are already in the queue."
msgstr "Вы уже стоите в очереди."

msgid "You are not a member of this channel."
msgstr "Вы не участник этого канала."

msgid "You are not a member of this chat."
msgstr "Вы не участник этого чата."

msgid "You cannot block yourself."
msgstr "Нельзя заблокировать себя."

msgid "You have a new notification."
msgstr "У вас новое уведомление."

msgid "You have already reviewed the other participant of this interaction."
msgstr "Вы уже оставили отзыв о втором участнике этого взаимодействия."

msgid "You have no offer of a place."
msgstr "У вас нет предложения места."

msgid "You have no pending request to leave."
msgstr "У вас нет активного запроса на выход."

msgid "Your Campus e-mail confirmation code"
msgstr "Ваш код подтверждения почты в Кампус"

msgid "Your Campus sign-in code"
msgstr "Ваш код входа в Кампус"

msgid ""
"Your account e-mail addresses have changed. If this was not you, contact "
