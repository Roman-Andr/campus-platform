          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"chat_messages\" (\"owner\" TEXT NOT NULL, \"chat_id\" TEXT NOT NULL, \"client_id\" TEXT NOT NULL, \"server_id\" TEXT NOT NULL, \"sequence\" INTEGER NOT NULL, \"sender_id\" TEXT NOT NULL, \"body\" TEXT NOT NULL, \"version\" INTEGER NOT NULL DEFAULT 1, \"reply_to_id\" TEXT NULL, \"reply_to_payload\" TEXT NULL, \"photo_ids\" TEXT NULL, \"quote_revision\" INTEGER NOT NULL DEFAULT 0, \"created_at\" TEXT NOT NULL, PRIMARY KEY (\"owner\", \"chat_id\", \"client_id\"), UNIQUE (\"owner\", \"chat_id\", \"sequence\"));"
