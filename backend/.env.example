# Backend settings. Copy to `.env` (not committed) and adjust; real
# environment variables take precedence over the file.
# Secrets (Sentry DSN, later database and SMTP passwords) are never committed.

# development | test | staging | production
CAMPUS_ENVIRONMENT=development
# Build identifier for error reports, e.g. a git commit SHA.
CAMPUS_RELEASE=

# DEBUG | INFO | WARNING | ERROR | CRITICAL
CAMPUS_LOG_LEVEL=INFO
# json (default, required on servers) | console (local development)
CAMPUS_LOG_FORMAT=json

CAMPUS_API_HOST=127.0.0.1
CAMPUS_API_PORT=8000

# PostgreSQL 18 with pgvector. Format:
#   postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DATABASE
# (a postgresql:// URL is switched to the asyncpg driver). Required by the
# API and by `alembic upgrade head`; the password is a secret.
CAMPUS_DATABASE_URL=
# Connection pool of each process.
CAMPUS_DATABASE_POOL_SIZE=10
CAMPUS_DATABASE_MAX_OVERFLOW=10
# Seconds to wait for a free connection.
CAMPUS_DATABASE_POOL_TIMEOUT=30

# Error reporting (Sentry SDK, GlitchTip server); empty disables it.
CAMPUS_SENTRY_DSN=
# Share of requests traced for performance monitoring, 0.0-1.0.
CAMPUS_SENTRY_TRACES_SAMPLE_RATE=0.0

# Language of API messages when the request's Accept-Language matches none
# of the supported ones: ru | en.
CAMPUS_DEFAULT_LOCALE=ru
# Oldest supported client version per platform (android, web, desktop,
# telegram, admin), as JSON; older clients get 426 client_update_required.
# Example: {"android": "1.2.0", "web": "1.2.0"}
CAMPUS_CLIENT_MIN_VERSIONS={}
# How long an Idempotency-Key and its response are kept: seconds or an
# ISO 8601 duration (PT24H).
CAMPUS_IDEMPOTENCY_KEY_TTL=PT24H
# Page size of lists when the request has no `size`, and its upper limit.
CAMPUS_PAGE_SIZE_DEFAULT=20
CAMPUS_PAGE_SIZE_MAX=100
