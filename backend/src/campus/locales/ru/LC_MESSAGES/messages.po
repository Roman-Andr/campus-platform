msgid "Authentication required"
msgstr "Требуется вход в аккаунт"

msgid "Bad request"
msgstr "Некорректный запрос"

msgid "Client version missing"
msgstr "Не указана версия клиента"

msgid "E-mail domain not allowed"
msgstr "Домен почты не разрешён"

msgid "Employees have no course."
msgstr "У сотрудников нет курса."

msgid "Fill in your profile first: campus city, faculty and course."
msgstr "Сначала заполните профиль: город-кампус, факультет и курс."

msgid "First and last names are required"
msgstr "Укажите имя и фамилию"

msgid "Has an invalid format."
msgstr "Неверный формат."

msgid "Idempotency key missing"
msgstr "Нет ключа идемпотентности"

msgid "Idempotency key reused"
msgstr "Ключ идемпотентности уже использован"

msgid "Internal error"
msgstr "Внутренняя ошибка"

msgid "Invalid client version"
msgstr "Неверная версия клиента"

msgid "Invalid cursor"
msgstr "Неверный курсор"

msgid "Invalid idempotency key"
msgstr "Неверный ключ идемпотентности"

msgid "Invalid refresh token"
msgstr "Недействительный токен обновления"

msgid "Invalid request"
msgstr "Неверные данные запроса"

msgid "Invalid sign-in code"
msgstr "Неверный код входа"

msgid "Method not allowed"
msgstr "Метод не поддерживается"

msgid "Must be a UUID."
msgstr "Должно быть UUID."

msgid "Must be a date and time."
msgstr "Должно быть датой и временем."

msgid "Must be a date."
msgstr "Должно быть датой."

msgid "Must be a list."
msgstr "Должно быть списком."

msgid "Must be a number."
msgstr "Должно быть числом."

msgid "Must be a string."
msgstr "Должно быть строкой."

msgid "Must be an integer."
msgstr "Должно быть целым числом."

msgid "Must be an object."
msgstr "Должно быть объектом."

#, python-brace-format
msgid "Must be at least {ge}."
msgstr "Должно быть не меньше {ge}."

#, python-brace-format
msgid "Must be at least {min_length} characters long."
msgstr "Минимальная длина — {min_length}."

#, python-brace-format
msgid "Must be at most {le}."
msgstr "Должно быть не больше {le}."

#, python-brace-format
msgid "Must be at most {max_length} characters long."
msgstr "Максимальная длина — {max_length}."

#, python-brace-format
msgid "Must be at most {max}."
msgstr "Должно быть не больше {max}."

#, python-brace-format
msgid "Must be greater than {gt}."
msgstr "Должно быть больше {gt}."

#, python-brace-format
msgid "Must be less than {lt}."
msgstr "Должно быть меньше {lt}."

msgid "Must be one of the chosen city."
msgstr "Должно относиться к выбранному городу."

#, python-brace-format
msgid "Must be one of: {expected}."
msgstr "Допустимые значения: {expected}."

msgid "Must be true or false."
msgstr "Должно быть true или false."

#, python-brace-format
msgid "Must have at least {min_length} items."
msgstr "Минимальное число элементов — {min_length}."

#, python-brace-format
msgid "Must have at most {max_length} items."
msgstr "Максимальное число элементов — {max_length}."

msgid "No such campus city."
msgstr "Такого города-кампуса нет."

msgid "Not found"
msgstr "Не найдено"

msgid "Profile incomplete"
msgstr "Профиль не заполнен"

#, python-brace-format
msgid "Reload the listing. Its current version is {version}."
msgstr "Обновите объявление. Его текущая версия: {version}."

msgid "Request failed"
msgstr "Запрос не выполнен"

msgid "Requests that change data need an Idempotency-Key header."
msgstr "Изменяющему запросу нужен заголовок Idempotency-Key."

msgid "Sign-in attempts exceeded"
msgstr "Превышено число попыток входа"

msgid "Sign-in code expired or already used"
msgstr "Код входа истёк или уже использован"

msgid "Some fields of the request are invalid."
msgstr "Некоторые поля запроса заполнены неверно."

msgid "Something went wrong on our side. Please try again later."
msgstr "Что-то пошло не так на нашей стороне. Попробуйте позже."

msgid "Students must give their course."
msgstr "Студенту нужно указать курс."

msgid "The Idempotency-Key header must be a UUID."
msgstr "Заголовок Idempotency-Key должен быть UUID."

msgid "The X-Client-Platform and X-Client-Version headers are required."
msgstr "Нужны заголовки X-Client-Platform и X-Client-Version."

msgid "The client platform or version is not recognized."
msgstr "Платформа или версия клиента не распознаны."

msgid "The listing state has changed."
msgstr "Состояние объявления изменилось."

msgid "The listing text is empty or too long."
msgstr "Текст объявления пуст или слишком длинный."

msgid "The listing was edited."
msgstr "Объявление было изменено."

msgid "The page cursor is invalid or belongs to another list; start over."
msgstr "Курсор страницы неверен или относится к другому списку; начните сначала."

msgid "The request body is not valid JSON."
msgstr "Тело запроса — некорректный JSON."

msgid "The requested resource does not exist."
msgstr "Запрошенный ресурс не существует."

msgid "The resource does not support this method."
msgstr "Ресурс не поддерживает этот метод."

msgid "This Idempotency-Key was already used for a different request."
msgstr "Этот Idempotency-Key уже использован для другого запроса."

msgid "This action is not allowed."
msgstr "Это действие запрещено."

msgid "This field is not allowed."
msgstr "Это поле недопустимо."

msgid "This field is required."
msgstr "Обязательное поле."

#, python-brace-format
msgid ""
"This version of the app is no longer supported. Please update to "
"{version} or newer."
msgstr ""
"Эта версия приложения больше не поддерживается. Обновите его до версии "
"{version} или новее."

msgid "Too many requests"
msgstr "Слишком много запросов"

msgid "Update required"
msgstr "Требуется обновление"

msgid "Your Campus sign-in code"
msgstr "Ваш код входа в Кампус"

#, python-brace-format
msgid "Your sign-in code: {code}. It expires in {minutes} minutes."
msgstr "Ваш код входа: {code}. Он действует {minutes} минут."


msgid "Forbidden"
msgstr "Доступ запрещён"
