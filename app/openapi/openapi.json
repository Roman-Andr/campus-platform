        "operationId": "list_faculties",
        "parameters": [
          {
            "name": "city_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid",
              "description": "Only those of this city.",
              "title": "City Id"
            },
            "description": "Only those of this city."
          },
          {
            "name": "X-Client-Platform",
            "in": "header",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/ClientPlatform",
              "description": "Client application."
            },
            "description": "Client application."
          },
          {
            "name": "X-Client-Version",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Client version, e.g. 1.4.0.",
              "examples": [
                "1.0.0"
              ],
              "title": "X-Client-Version"
            },
            "description": "Client version, e.g. 1.4.0."
          }
