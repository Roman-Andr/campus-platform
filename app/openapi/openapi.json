{
  "openapi": "3.1.0",
  "info": {
    "title": "Campus API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Check that the API is alive",
        "description": "Return 200 while the API process is able to serve requests.",
        "operationId": "get_health",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/university/cities": {
      "get": {
        "tags": [
          "university"
        ],
        "summary": "List Cities",
        "description": "All campus cities, by name.",
        "operationId": "list_cities",
        "parameters": [
          {
            "name": "X-Client-Platform",
            "in": "header",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/ClientPlatform",
              "description": "Client application."
            },
            "description": "Client application."
          },
          {
            "name": "X-Client-Version",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Client version, e.g. 1.4.0.",
              "examples": [
                "1.0.0"
              ],
              "title": "X-Client-Version"
            },
            "description": "Client version, e.g. 1.4.0."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CityList"
                }
              }
            }
          },
          "400": {
            "description": "Bad request: client headers or Idempotency-Key missing or invalid (client_version_missing, client_version_invalid, idempotency_key_missing, idempotency_key_invalid, ...).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Invalid request (validation_failed) or Idempotency-Key used for a different request (idempotency_key_reused).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "426": {
            "description": "The client version is too old (client_update_required).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "500": {
            "description": "Internal error (internal_error).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/university/dormitories": {
