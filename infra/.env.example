# Docker Compose settings. Copy to `.env` in infra/ (never committed) and
# adjust. The values below suit local development only: on a server,
# replace every secret, e.g. with `openssl rand -hex 32`. Use URL-safe
# characters (letters, digits, -._~) in passwords: they are embedded into
# connection URLs.

# --- Compose ----------------------------------------------------------------
# Leave unset in development: compose.override.yaml (Mailpit, published
# ports) is then applied. On a server use the base file only:
# COMPOSE_FILE=compose.yaml
# Server image; built from backend/ when absent. CI sets a registry tag.
CAMPUS_BACKEND_IMAGE=campus-backend:local

# --- Domains and ports ------------------------------------------------------
# Public addresses served by Caddy. `localhost` gets a certificate from
# Caddy's local CA; a public domain gets one from Let's Encrypt.
CAMPUS_DOMAIN=localhost
CAMPUS_STORAGE_DOMAIN=storage.localhost
# Host ports of Caddy.
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# --- Backend (CAMPUS_*, see backend/.env.example) ---------------------------
# development | test | staging | production
CAMPUS_ENVIRONMENT=development
CAMPUS_RELEASE=
CAMPUS_LOG_LEVEL=INFO
CAMPUS_LOG_FORMAT=json
CAMPUS_SENTRY_DSN=
CAMPUS_SENTRY_TRACES_SAMPLE_RATE=0.0
# Peers whose X-Forwarded-For is trusted by the API. Unset: the private
# ranges of the compose networks, i.e. Caddy. Narrow it to the subnet of
# the `edge` network or widen it when another proxy sits in front of Caddy.
CAMPUS_TRUSTED_PROXIES=
# Outgoing mail of the worker. Development: Mailpit from
# compose.override.yaml (web UI on DEV_MAILPIT_UI_PORT). Server: the SMTP
# relay of the university or a mail provider, e.g. port 587 with starttls
# or 465 with tls; the password is a secret.
CAMPUS_SMTP_HOST=mailpit
CAMPUS_SMTP_PORT=1025
# none | starttls | tls
CAMPUS_SMTP_SECURITY=none
CAMPUS_SMTP_USERNAME=
CAMPUS_SMTP_PASSWORD=
CAMPUS_MAIL_FROM=Campus <noreply@campus.localhost>

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_USER=campus
POSTGRES_PASSWORD=campus-dev-password
POSTGRES_DB=campus

# --- Redis ------------------------------------------------------------------
REDIS_PASSWORD=campus-dev-password

# --- Centrifugo -------------------------------------------------------------
# Signs client connection tokens issued by the API.
CENTRIFUGO_TOKEN_HMAC_SECRET=campus-dev-token-secret
# Key of Centrifugo's server API used by the backend to publish.
CENTRIFUGO_HTTP_API_KEY=campus-dev-api-key

# --- RustFS (S3) ------------------------------------------------------------
RUSTFS_ACCESS_KEY=campus-dev
RUSTFS_SECRET_KEY=campus-dev-secret-key

# --- Development only (compose.override.yaml) -------------------------------
# Loopback ports for tools on the host.
DEV_POSTGRES_PORT=5432
DEV_REDIS_PORT=6379
DEV_CENTRIFUGO_PORT=8001
DEV_RUSTFS_PORT=9000
DEV_RUSTFS_CONSOLE_PORT=9001
DEV_MAILPIT_SMTP_PORT=1025
DEV_MAILPIT_UI_PORT=8025

# Encryption of stored idempotent responses (API only, required): comma-
# separated base64 32-byte keys; the first one encrypts, all decrypt.
# The key below is for development only: on a server generate a new one
# with `openssl rand -base64 32`. Rotation: put a new key first, remove
# the old one after CAMPUS_IDEMPOTENCY_KEY_TTL (24 h).
CAMPUS_IDEMPOTENCY_ENCRYPTION_KEYS=ZGV2ZWxvcG1lbnQtb25seS1pZGVtcG90ZW5jeS1rZXk=

# Authentication: generate a secret with `openssl rand -hex 32`.
# At least 32 characters; required by authentication endpoints.
CAMPUS_AUTH_SECRET_KEY=
CAMPUS_ACCESS_TOKEN_TTL=PT15M
CAMPUS_REFRESH_TOKEN_TTL=P30D
CAMPUS_SIGN_IN_CODE_TTL=PT10M
CAMPUS_SIGN_IN_CODE_MAX_ATTEMPTS=5
CAMPUS_SIGN_IN_EMAIL_LIMITS=3/15 minutes;10/day
CAMPUS_SIGN_IN_IP_LIMITS=60/minute
# Retention of credentials, deleted by the cleanup task: expired sign-in
# codes; used refresh tokens of live sessions after their expiry (reuse
# within the window still revokes the session); revoked or expired sessions
# with their refresh tokens.
CAMPUS_SIGN_IN_CODE_RETENTION=P1D
CAMPUS_REFRESH_TOKEN_REUSE_WINDOW=P30D
CAMPUS_SESSION_RETENTION=P7D
