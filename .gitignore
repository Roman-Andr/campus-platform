# OS
.DS_Store
Thumbs.db
desktop.ini

# Editors and IDEs
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.iml
*.swp
*.swo
*~

# Local environment and secrets
.env
.env.*
!.env.example
*.pem
*.key

# Logs and temporary files
*.log
tmp/

# Typst build output: only the approved specification is versioned
docs/paperwork/pdf/*.pdf
!docs/paperwork/pdf/ТЗ_*.pdf
