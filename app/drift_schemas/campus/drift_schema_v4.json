          "sql": "CREATE TABLE IF NOT EXISTS \"chat_outbox\" (\"owner\" TEXT NOT NULL, \"chat_id\" TEXT NOT NULL, \"client_id\" TEXT NOT NULL, \"idempotency_key\" TEXT NOT NULL, \"body\" TEXT NOT NULL, \"reply_to_id\" TEXT NULL, \"reply_to_payload\" TEXT NULL, \"quote_revision\" INTEGER NOT NULL DEFAULT 0, \"photo_ids\" TEXT NULL, \"created_at\" TEXT NOT NULL, \"attempts\" INTEGER NOT NULL DEFAULT 0, \"status\" TEXT NOT NULL DEFAULT 'pending', \"failure\" TEXT NULL, PRIMARY KEY (\"owner\", \"chat_id\", \"client_id\"), UNIQUE (\"owner\", \"idempotency_key\"));"
