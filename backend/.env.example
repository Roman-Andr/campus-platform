# Backend settings. Copy to `.env` (not committed) and adjust; real
# environment variables take precedence over the file.
# Secrets (Sentry DSN, later database and SMTP passwords) are never committed.

# development | test | staging | production
CAMPUS_ENVIRONMENT=development
# Build identifier for error reports, e.g. a git commit SHA.
CAMPUS_RELEASE=

# DEBUG | INFO | WARNING | ERROR | CRITICAL
CAMPUS_LOG_LEVEL=INFO
# json (default, required on servers) | console (local development)
CAMPUS_LOG_FORMAT=json

CAMPUS_API_HOST=127.0.0.1
CAMPUS_API_PORT=8000
# Reverse proxies trusted to set X-Forwarded-For/-Proto: comma-separated
# addresses and networks, or * for any peer. Requests from other peers
# keep their socket address (the sign-in IP limit relies on it).
CAMPUS_TRUSTED_PROXIES=127.0.0.1

# PostgreSQL 18 with pgvector. Format:
#   postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DATABASE
# (a postgresql:// URL is switched to the asyncpg driver). Required by the
# API and by `alembic upgrade head`; the password is a secret.
CAMPUS_DATABASE_URL=
# Connection pool of each process.
CAMPUS_DATABASE_POOL_SIZE=10
CAMPUS_DATABASE_MAX_OVERFLOW=10
# Seconds to wait for a free connection.
CAMPUS_DATABASE_POOL_TIMEOUT=30

# Redis of the task queue (Taskiq), required by the worker and the
# scheduler. Format: redis://:PASSWORD@HOST:PORT/DB; the password is a secret.
CAMPUS_REDIS_URL=

# Background jobs: outbox messages and deadlines.
# Seconds between outbox polls of the worker when there is nothing to do.
CAMPUS_OUTBOX_POLL_INTERVAL=1.0
# Jobs run per pass.
CAMPUS_JOB_BATCH_SIZE=100
# Attempts of a failing job before it is marked failed. Durations below:
# seconds or an ISO 8601 duration (PT10S, PT1H, P7D).
CAMPUS_JOB_MAX_ATTEMPTS=10
# Delay before the first retry (doubles with every attempt) and its limit.
CAMPUS_JOB_RETRY_BASE_DELAY=PT10S
CAMPUS_JOB_RETRY_MAX_DELAY=PT1H
# How long finished outbox messages and deadlines are kept.
CAMPUS_OUTBOX_RETENTION=P7D
CAMPUS_DEADLINE_RETENTION=P7D
# Cron schedules (UTC) of the scheduler: due deadlines and retention cleanup
# (outbox, deadlines, expired idempotency keys).
CAMPUS_DEADLINES_CRON=* * * * *
CAMPUS_CLEANUP_CRON=30 3 * * *

# Outgoing mail. Empty host: letters stay in the outbox and fail after the
# retries. Mailpit in development: host 127.0.0.1 (mailpit in Compose), port
# 1025, security none. Security: none | starttls | tls (implicit TLS).
CAMPUS_SMTP_HOST=
CAMPUS_SMTP_PORT=587
CAMPUS_SMTP_SECURITY=starttls
CAMPUS_SMTP_USERNAME=
# A secret.
CAMPUS_SMTP_PASSWORD=
# Seconds.
CAMPUS_SMTP_TIMEOUT=30.0
CAMPUS_MAIL_FROM=Campus <noreply@campus.localhost>

# Error reporting (Sentry SDK, GlitchTip server); empty disables it.
CAMPUS_SENTRY_DSN=
# Share of requests traced for performance monitoring, 0.0-1.0.
CAMPUS_SENTRY_TRACES_SAMPLE_RATE=0.0

# Language of API messages when the request's Accept-Language matches none
# of the supported ones: ru | en.
CAMPUS_DEFAULT_LOCALE=ru
# Oldest supported client version per platform (android, web, desktop,
# telegram, admin), as JSON; older clients get 426 client_update_required.
# Example: {"android": "1.2.0", "web": "1.2.0"}
CAMPUS_CLIENT_MIN_VERSIONS={}
# How long an Idempotency-Key and its response are kept: seconds or an
# ISO 8601 duration (PT24H).
CAMPUS_IDEMPOTENCY_KEY_TTL=PT24H
# Page size of lists when the request has no `size`, and its upper limit.
CAMPUS_PAGE_SIZE_DEFAULT=20
CAMPUS_PAGE_SIZE_MAX=100

# Authentication: generate a secret with `openssl rand -hex 32`.
# At least 32 characters; required by authentication endpoints.
CAMPUS_AUTH_SECRET_KEY=
CAMPUS_ACCESS_TOKEN_TTL=PT15M
CAMPUS_REFRESH_TOKEN_TTL=P30D
CAMPUS_SIGN_IN_CODE_TTL=PT10M
CAMPUS_SIGN_IN_CODE_MAX_ATTEMPTS=5
CAMPUS_SIGN_IN_EMAIL_LIMITS=3/15 minutes;10/day
CAMPUS_SIGN_IN_IP_LIMITS=60/minute
